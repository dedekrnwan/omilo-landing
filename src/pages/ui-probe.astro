---
/**
 * ui-probe.astro — throwaway build-smoke page (deleted in a later task).
 * Imports all five UI primitives so `astro build` exercises them.
 * Also imports Task 6 section components: Nav, Hero, LanguageSwitcher.
 * DO NOT link from the real site; this page is for CI/build checks only.
 */
import Button from '../components/ui/Button.astro';
import Reveal from '../components/ui/Reveal.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Badge from '../components/ui/Badge.astro';
import AppShell from '../components/ui/AppShell.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import LanguageSwitcher from '../components/sections/LanguageSwitcher.astro';
import SocialProof from '../components/sections/SocialProof.astro';
import AgentsTeam from '../components/sections/AgentsTeam.astro';
import ApprovalLoop from '../components/sections/ApprovalLoop.astro';
import Features from '../components/sections/Features.astro';
import Integrations from '../components/sections/Integrations.astro';
import MultiCompany from '../components/sections/MultiCompany.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Pricing from '../components/sections/Pricing.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import Footer from '../components/sections/Footer.astro';
import { getContent } from '../i18n';

const c = getContent('en');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UI probe (not for production)</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body style="padding: 2rem; font-family: sans-serif;">
    <h1>UI probe -- build smoke</h1>

    <!-- Button: all variants -->
    <section style="margin: 2rem 0; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
      <Button href="#" variant="primary">Primary</Button>
      <Button href="#" variant="secondary">Secondary</Button>
      <Button href="#" variant="ghost">Ghost</Button>
      <div style="background:#0c0a09; padding: 0.5rem 1rem; border-radius: 8px; display: flex; gap: 1rem;">
        <Button href="#" variant="ghost-inverse">Ghost Inverse</Button>
        <Button href="#" variant="secondary-inverse">Secondary Inverse</Button>
      </div>
    </section>

    <!-- Badge: all tones -->
    <section style="margin: 2rem 0; display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
      <Badge label="Neutral" tone="neutral" />
      <Badge label="Status OK" tone="ok" />
      <Badge label="Coming Soon" tone="soon" />
    </section>

    <!-- SectionHeader: default + inverse + centered -->
    <section style="margin: 2rem 0; display: flex; flex-direction: column; gap: 2rem;">
      <SectionHeader
        eyebrow="Eyebrow"
        title="Default section title"
        subtitle="Supporting subtitle copy that spans one or two lines."
      />
      <SectionHeader
        title="Centered, no eyebrow"
        subtitle="A centered layout, no eyebrow pill."
        align="center"
      />
      <div style="background:#0c0a09; padding: 2rem; border-radius: 12px;">
        <SectionHeader
          eyebrow="Inverse"
          title="Inverse tone title"
          subtitle="White text on a dark background."
          tone="inverse"
        />
      </div>
    </section>

    <!-- Reveal -->
    <Reveal class="probe-reveal" delay={100}>
      <p>Reveal wrapper (data-reveal element)</p>
    </Reveal>

    <!-- AppShell -->
    <section style="margin: 2rem 0; max-width: 900px;">
      <AppShell />
    </section>

    <!-- Task 6: LanguageSwitcher -->
    <section style="margin: 2rem 0;">
      <LanguageSwitcher locale="en" />
    </section>

    <!-- Task 6: Nav -->
    <Nav content={c.nav} locale="en" />

    <!-- Task 6: Hero -->
    <Hero content={c.hero} locale="en" />

    <!-- Task 7: SocialProof -->
    <SocialProof content={c.socialProof} locale="en" />

    <!-- Task 7: AgentsTeam -->
    <AgentsTeam content={c.agents} locale="en" />

    <!-- Task 8: ApprovalLoop -->
    <ApprovalLoop content={c.approvalLoop} locale="en" />

    <!-- Task 8: Features -->
    <Features content={c.features} locale="en" />

    <!-- Task 9: Integrations -->
    <Integrations content={c.integrations} locale="en" />

    <!-- Task 9: MultiCompany -->
    <MultiCompany content={c.multiCompany} locale="en" />

    <!-- Task 10: HowItWorks -->
    <HowItWorks content={c.howItWorks} locale="en" />

    <!-- Task 10: Pricing -->
    <Pricing content={c.pricing} locale="en" />

    <!-- Task 11: Faq -->
    <Faq content={c.faq} locale="en" />

    <!-- Task 11: FinalCta -->
    <FinalCta content={c.finalCta} locale="en" />

    <!-- Task 11: Footer -->
    <Footer content={c.footer} locale="en" />
  </body>
</html>
