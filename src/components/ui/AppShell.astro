---
/**
 * AppShell.astro — Saga OS workspace mock (hero centerpiece, Task 4).
 *
 * Renders an illustrative OS-window chrome entirely in HTML/CSS/inline SVG.
 * No external images, no screenshots, no invented real metrics.
 * Flat design: --shadow-float on the main card only; near-zero decoration.
 *
 * Design decisions (antislop-ui):
 * - Shadow used once (the workspace card), everything else flat.
 * - No glow, no pulsing dots, no bento grid, no fake live indicator.
 * - Agent color dots are identity marks, not status indicators (no pulse).
 * - Numbers are clearly illustrative ("~2.1 K tok") — not presented as live data.
 * - Sidebar hides on narrow viewports (< 640px) via CSS.
 */

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class={[
    'app-shell rounded-[12px] border border-line overflow-hidden font-sans text-ink bg-app select-none',
    className,
  ]
    .filter(Boolean)
    .join(' ')}
>
  <!-- Window chrome bar -->
  <div class="chrome flex items-center gap-2 px-4 py-2.5 bg-surface border-b border-line">
    <!-- Traffic-light dots (decorative affordance only, not status) -->
    <span class="dot" style="background:var(--color-line);"></span>
    <span class="dot" style="background:var(--color-line);"></span>
    <span class="dot" style="background:var(--color-line);"></span>
    <span class="chrome-title">Saga OS</span>
  </div>

  <!-- Body: sidebar + main -->
  <div class="shell-body flex" style="min-height: 320px;">

    <!-- Sidebar -->
    <aside class="sidebar border-r border-line bg-surface flex flex-col gap-0" style="width: 200px; flex-shrink: 0;">

      <!-- Workspace label -->
      <div class="px-4 pt-4 pb-2">
        <span class="text-[10px] font-bold uppercase tracking-widest text-muted">Workspace</span>
      </div>

      <!-- Nav rows -->
      <nav class="flex flex-col px-2 gap-0.5">
        <a href="#" class="nav-row nav-row--active" tabindex="-1">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="2" y="2" width="5" height="5" rx="1.5" fill="currentColor" opacity=".7"/><rect x="9" y="2" width="5" height="5" rx="1.5" fill="currentColor" opacity=".4"/><rect x="2" y="9" width="5" height="5" rx="1.5" fill="currentColor" opacity=".4"/><rect x="9" y="9" width="5" height="5" rx="1.5" fill="currentColor" opacity=".4"/></svg>
          Overview
        </a>
        <a href="#" class="nav-row" tabindex="-1">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2C8 2 3 5.5 3 9a5 5 0 0 0 10 0C13 5.5 8 2 8 2Z" fill="currentColor" opacity=".5"/><circle cx="8" cy="9" r="2" fill="currentColor"/></svg>
          Inbox
        </a>
        <a href="#" class="nav-row" tabindex="-1">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="5" r="3" fill="currentColor" opacity=".6"/><path d="M2 13c0-2.76 2.686-5 6-5s6 2.24 6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".5"/></svg>
          Staff
        </a>
        <a href="#" class="nav-row" tabindex="-1">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="3" y="2" width="10" height="12" rx="2" fill="currentColor" opacity=".3"/><rect x="5" y="5" width="6" height="1.2" rx=".6" fill="currentColor" opacity=".7"/><rect x="5" y="8" width="4" height="1.2" rx=".6" fill="currentColor" opacity=".5"/></svg>
          Docs
        </a>
        <a href="#" class="nav-row" tabindex="-1">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity=".6"/></svg>
          Monitor
        </a>
      </nav>

      <!-- Spacer -->
      <div class="flex-1"></div>

      <!-- Agent mascot dots — identity marks, no pulse/glow -->
      <div class="px-4 pb-4 pt-3 border-t border-line">
        <span class="text-[10px] font-bold uppercase tracking-widest text-muted block mb-2">Agents</span>
        <div class="flex items-center gap-2">
          <span
            class="agent-dot"
            title="Analyst"
            style="background: var(--color-link);"
          ></span>
          <span
            class="agent-dot"
            title="Writer"
            style="background: var(--color-ok);"
          ></span>
          <span
            class="agent-dot"
            title="Reviewer"
            style="background: var(--color-warn);"
          ></span>
          <span
            class="agent-dot agent-dot--idle"
            title="Idle slot"
          ></span>
        </div>
      </div>
    </aside>

    <!-- Main workspace -->
    <main class="shell-main flex-1 p-5 flex flex-col gap-4 bg-app overflow-hidden">

      <!-- Breadcrumb / page title -->
      <div class="flex items-center gap-2 text-xs text-muted">
        <span>Overview</span>
        <span aria-hidden="true">/</span>
        <span class="text-ink font-medium">Active runs</span>
      </div>

      <!-- Working card — the centrepiece inset surface -->
      <div
        class="working-card rounded-[12px] border border-line bg-surface p-5 flex flex-col gap-4"
        style="box-shadow: var(--shadow-float);"
      >
        <!-- Card header -->
        <div class="flex items-start justify-between gap-3">
          <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2">
              <!-- Agent identity dot (matches sidebar dot, same hue = same agent) -->
              <span
                style="width:8px; height:8px; border-radius:50%; background:var(--color-link); flex-shrink:0; display:inline-block;"
                aria-hidden="true"
              ></span>
              <span class="text-sm font-semibold text-ink">Analyst</span>
              <span class="text-xs text-muted font-medium">· Research</span>
            </div>
            <!-- Reasoning snippet — clearly illustrative, one line -->
            <p class="text-xs text-muted leading-relaxed pl-[20px]">
              Scanning community signals across 3 data sources&hellip;
            </p>
          </div>

          <!-- Status tag (plain text, no dot-glow) -->
          <span class="status-tag">Working</span>
        </div>

        <!-- Token / cost meter — labelled as illustrative -->
        <div class="flex flex-col gap-1.5">
          <div class="flex items-center justify-between text-[10px] text-muted">
            <span>Token budget</span>
            <span aria-label="approximately 2.1 thousand tokens used of 8 thousand">~2.1 K / 8 K tok</span>
          </div>
          <div
            class="meter-track rounded-full overflow-hidden"
            role="progressbar"
            aria-valuenow="26"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-label="Token budget: 26% used"
          >
            <div class="meter-fill" style="width: 26%;"></div>
          </div>
        </div>
      </div>

      <!-- Two placeholder rows (queued jobs) — clearly empty state, not fake data -->
      <div class="flex flex-col gap-2">
        <div class="queue-row">
          <span class="queue-dot" style="background:var(--color-ok);"></span>
          <span class="text-xs text-ink flex-1">Writer · Draft synthesis</span>
          <span class="text-[10px] text-muted">queued</span>
        </div>
        <div class="queue-row">
          <span class="queue-dot" style="background:var(--color-warn);"></span>
          <span class="text-xs text-ink flex-1">Reviewer · Fact-check pass</span>
          <span class="text-[10px] text-muted">waiting</span>
        </div>
      </div>

      <!-- Slot for any additional content the parent wants to inject -->
      <slot />
    </main>
  </div>
</div>

<style>
  /* Window chrome dots */
  .dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .chrome-title {
    margin-left: auto;
    margin-right: auto;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-muted);
    letter-spacing: 0.03em;
  }

  /* Sidebar nav rows */
  .nav-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-row:hover {
    background: var(--color-soft);
    color: var(--color-ink);
  }
  .nav-row--active {
    background: var(--color-soft);
    color: var(--color-ink);
    font-weight: 600;
  }

  /* Agent identity dots — no pulse, no glow; intentionally static */
  .agent-dot {
    display: inline-block;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .agent-dot--idle {
    background: var(--color-line);
  }

  /* Working card status tag */
  .status-tag {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: 10px;
    font-weight: 600;
    font-family: var(--font-mono);
    background: var(--color-soft);
    color: var(--color-muted);
    border: 1px solid var(--color-line);
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* Token meter */
  .meter-track {
    height: 4px;
    background: var(--color-line);
    border-radius: 999px;
  }
  .meter-fill {
    height: 100%;
    background: var(--color-primary);
    border-radius: 999px;
  }

  /* Queue rows */
  .queue-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .queue-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Responsive: hide sidebar on narrow viewports */
  @media (max-width: 639px) {
    .sidebar {
      display: none;
    }
  }
</style>
