---
/** FinalCta.astro: closing call to join the waitlist. */
import type { Content } from '../../data/types';
import Mascot from '../ui/Mascot.astro';
interface Props { content: Content['finalCta'] }
const { content } = Astro.props;
---
<section class="cta" id="final-cta" aria-labelledby="final-cta-h">
  <div class="wrap">
    <div class="card">
      <Mascot name="chief" size={56} />
      <h2 id="final-cta-h">{content.headline}</h2>
      <p>{content.subtext}</p>
      <button type="button" class="btn primary lg" data-open="waitlist">{content.cta}</button>
      <span class="micro">{content.microcopy}</span>
    </div>
  </div>
</section>
<style>
  .cta { padding-block: 40px 80px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 48px 24px; text-align: center; display: grid; justify-items: center; gap: 14px; }
  h2 { font: 500 clamp(32px, 4.4vw, 48px)/1.1 var(--font-serif); letter-spacing: -.02em; color: #1c1917; }
  p { color: var(--ink-2); max-width: 34em; }
  .micro { font-size: 13px; color: var(--muted); }
</style>
