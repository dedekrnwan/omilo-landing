---
interface Props {
  label: string;
  tone?: 'neutral' | 'ok' | 'soon';
  class?: string;
}

const {
  label,
  tone = 'neutral',
  class: className,
} = Astro.props as Props;

const toneClasses: Record<string, string> = {
  neutral: 'bg-soft text-muted border border-line',
  ok:      'bg-soft text-ok border border-line',
  soon:    'bg-soft text-muted border border-line',
};
---

<span
  class={[
    'inline-flex items-center rounded-md px-2.5 py-0.5 text-xs font-semibold font-sans',
    toneClasses[tone],
    className,
  ].filter(Boolean).join(' ')}
>
  {label}
</span>
