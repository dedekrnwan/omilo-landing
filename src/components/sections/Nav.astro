---
/** Nav.astro: sticky top bar with brand, section links, EN/ID switch and the waitlist CTA. */
import type { Content } from '../../data/types';
import { localizePath, type Locale } from '../../i18n';
import { GITHUB_URL } from '../../config';
import Mascot from '../ui/Mascot.astro';

interface Props { content: Content['nav']; locale: Locale }
const { content, locale } = Astro.props;
---
<header class="top">
  <div class="wrap bar">
    <a class="brand" href={localizePath('/', locale)} aria-label={content.homeAriaLabel}>
      <Mascot name="brand" size={30} />
      <span><b>{content.brand}</b><small>{content.tagline}</small></span>
    </a>
    <nav class="nav" aria-label="Main">
      {content.links.map((l) => <a class="btn quiet link" href={l.href}>{l.label}</a>)}
      <a class="btn sm gh" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
        <svg class="gh-ico" width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        {content.github}
      </a>
      <button type="button" class="btn primary sm" data-open="waitlist">{content.cta}</button>
      <div class="seg" role="group" aria-label={content.languageLabel}>
        <a href={localizePath('/', 'en')} hreflang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
        <a href={localizePath('/', 'id')} hreflang="id" aria-current={locale === 'id' ? 'true' : undefined}>ID</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .top { position: sticky; top: 0; z-index: 20; background: rgba(245, 245, 244, .9); backdrop-filter: saturate(1.2) blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 60px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--ink); }
  .brand:hover { text-decoration: none; }
  .brand b { display: block; font: 600 16px/1.2 var(--font-display); letter-spacing: -.01em; }
  .brand small { display: block; font-size: 12px; color: var(--muted); }
  .nav { display: flex; align-items: center; gap: 4px; }
  .gh { display: inline-flex; align-items: center; gap: 6px; }
  .gh-ico { flex: none; }
  .seg { display: inline-flex; padding: 2px; gap: 2px; border: 1px solid var(--line-strong); border-radius: var(--r); background: var(--surface); margin-left: 8px; }
  .seg a { display: inline-flex; align-items: center; height: 26px; padding: 0 9px; border-radius: 6px; font: 500 12px/1 var(--font-mono); color: var(--muted); }
  .seg a:hover { text-decoration: none; color: var(--ink); }
  .seg a[aria-current="true"] { background: var(--primary); color: #fff; }
  @media (max-width: 820px) { .link { display: none; } }
  @media (max-width: 420px) { .brand small { display: none; } }
</style>
