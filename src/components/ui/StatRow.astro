---
/** StatRow.astro: three equal panels with a label, a title and a line of body text. */
interface Props { items: { label: string; title: string; body: string }[] }
const { items } = Astro.props;
---
<div class="stats">
  {items.map((it) => (
    <div class="stat"><span class="label">{it.label}</span><div class="ttl">{it.title}</div><p>{it.body}</p></div>
  ))}
</div>
<style>
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .stat { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 16px 18px; min-width: 0; }
  .ttl { font: 600 17px/1.3 var(--font-display); margin: 6px 0 4px; }
  .stat p { font-size: 14px; color: var(--muted); }
  @media (max-width: 760px) { .stats { grid-template-columns: 1fr; } }
</style>
