---
/** Examples.astro: how the same helpers map to different kinds of business. */
import type { Content } from '../../data/types';
import SectionHead from '../ui/SectionHead.astro';
import Mascot from '../ui/Mascot.astro';
interface Props { content: Content['examples'] }
const { content } = Astro.props;
---
<section class="block" id="examples" aria-labelledby="examples-h">
  <div class="wrap">
    <SectionHead id="examples-h" eyebrow={content.eyebrow} heading={content.heading} subhead={content.subhead} />
    <div class="cards">
      {content.cards.map((card) => (
        <article class="card">
          <p class="ex">{card.label}</p>
          <h3>{card.title}</h3>
          <ul class="helpers">
            {card.helpers.map((h) => (
              <li class="row">
                <span class="face"><Mascot name={h.mascot} size={40} /></span>
                <div class="txt">
                  <b>{h.role}</b>
                  <span>{h.body}</span>
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 20px 20px 8px; box-shadow: var(--shadow-float); min-width: 0; }
  .ex { font-size: 11px; line-height: 12px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; color: var(--faint); }
  .card h3 { font: 500 24px/1.1 var(--font-display); letter-spacing: -.02em; margin: 6px 0 14px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .helpers { list-style: none; margin: 0; padding: 0; }
  .row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); min-width: 0; }
  .row:last-child { border-bottom: 0; }
  .face { flex: none; display: grid; }
  .txt { display: flex; flex-direction: column; min-width: 0; }
  .txt b { font-weight: 600; font-size: 15px; }
  .txt span { font-size: 14px; color: var(--muted); }
  @media (max-width: 900px) { .cards { grid-template-columns: 1fr; } }
</style>
