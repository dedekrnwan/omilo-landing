---
/**
 * Integrations.astro -- "The engine" section.
 *
 * Props: content (Content['integrations']), locale (Locale).
 *
 * Renders:
 *   - Section header (eyebrow, heading, subhead) from slice.
 *   - Engines: Claude Code pool + Built-in Claude (two primary cards, side by side).
 *   - Capabilities: MCP connectors, Skills, Shared folders (three secondary items).
 *   - Roadmap callout: Codex labelled as coming, using Badge tone="soon".
 *     FACTUAL GUARD: Codex is roadmap-only. Rendered as clearly not-yet-available.
 *     "Hermes" is never mentioned.
 *
 * Design notes:
 *   - Two-column engine layout, desktop. Stacks at tablet.
 *   - Capabilities in a three-column row below engines.
 *   - Roadmap note in a muted callout block at the bottom of the section.
 *   - Flat/minimal. No glow, no shadow, no decorative dots, no em dashes.
 *   - All copy from content prop.
 */
import type { IntegrationsContent } from '../../data/types';
import type { Locale } from '../../i18n';
import Reveal from '../ui/Reveal.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  content: IntegrationsContent;
  locale: Locale;
}

// locale reserved for future i18n use.
const { content, locale: _locale } = Astro.props;

// Engine-specific inline SVG icons -- relevant to the actual feature.
function getEngineIcon(name: string): string {
  const key = name.toLowerCase();

  if (key.includes('pool')) {
    // Stack of nodes / subscription pool icon
    return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <ellipse cx="12" cy="6" rx="8" ry="3" stroke="currentColor" stroke-width="1.4"/>
      <path d="M4 6v4c0 1.657 3.582 3 8 3s8-1.343 8-3V6" stroke="currentColor" stroke-width="1.4"/>
      <path d="M4 10v4c0 1.657 3.582 3 8 3s8-1.343 8-3v-4" stroke="currentColor" stroke-width="1.4"/>
      <path d="M4 14v4c0 1.657 3.582 3 8 3s8-1.343 8-3v-4" stroke="currentColor" stroke-width="1.4"/>
    </svg>`;
  }

  if (key.includes('built-in') || key.includes('api')) {
    // Key / API credential icon
    return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <circle cx="8.5" cy="12" r="4.5" stroke="currentColor" stroke-width="1.4"/>
      <path d="M13 12h7M17 10v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <path d="M20 10v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>`;
  }

  // Generic engine fallback: processor chip
  return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
    <rect x="6" y="6" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/>
    <path d="M9 2v2M12 2v2M15 2v2M9 20v2M12 20v2M15 20v2M2 9h2M2 12h2M2 15h2M20 9h2M20 12h2M20 15h2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
  </svg>`;
}

// Capability-specific inline SVG icons.
function getCapabilityIcon(title: string): string {
  const key = title.toLowerCase();

  if (key.includes('mcp')) {
    // Plug / connector icon
    return `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
      <path d="M7 2v5M13 2v5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      <rect x="4" y="7" width="12" height="6" rx="2" stroke="currentColor" stroke-width="1.3"/>
      <path d="M10 13v5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    </svg>`;
  }

  if (key.includes('skill')) {
    // Document with a checkmark: playbook icon
    return `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
      <rect x="3" y="2" width="12" height="16" rx="2" stroke="currentColor" stroke-width="1.3"/>
      <path d="M6 7h6M6 10.5h6M6 14h3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      <path d="M14 12l2 2 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`;
  }

  if (key.includes('folder') || key.includes('shared')) {
    // Folder with a share arrow
    return `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
      <path d="M2 5a2 2 0 0 1 2-2h3l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
      <path d="M10 9v4M8 11l2-2 2 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`;
  }

  // Generic fallback
  return `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
    <rect x="3" y="3" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.3"/>
    <path d="M7 10h6M10 7v6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
  </svg>`;
}
---

<section id="integrations" class="ig-section">
  <div class="ig-container">

    {/* Section header */}
    <Reveal>
      <SectionHeader
        eyebrow={content.eyebrow}
        title={content.heading}
        subtitle={content.subhead}
      />
    </Reveal>

    {/* Engines -- two primary cards */}
    <div class="ig-engines">
      {content.engines.map((engine, i) => (
        <Reveal delay={80 + i * 80} class="ig-engine-reveal">
          <article class="ig-engine-card">
            <div class="ig-engine-icon" set:html={getEngineIcon(engine.name)} />
            <div class="ig-engine-text">
              <h3 class="ig-engine-name">{engine.name}</h3>
              <p class="ig-engine-body">{engine.body}</p>
            </div>
          </article>
        </Reveal>
      ))}
    </div>

    {/* Capabilities -- three secondary items */}
    {content.capabilities && content.capabilities.length > 0 && (
      <div class="ig-capabilities">
        <p class="ig-cap-label">{content.capabilitiesLabel}</p>
        <div class="ig-cap-grid">
          {content.capabilities.map((cap, i) => (
            <Reveal delay={200 + i * 70} class="ig-cap-reveal">
              <div class="ig-cap-item">
                <div class="ig-cap-icon" set:html={getCapabilityIcon(cap.title)} />
                <div class="ig-cap-text">
                  <h4 class="ig-cap-title">{cap.title}</h4>
                  <p class="ig-cap-body">{cap.body}</p>
                </div>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    )}

    {/* Roadmap callout: Codex is not yet available -- clearly labelled coming */}
    <Reveal delay={400}>
      <aside class="ig-roadmap" aria-label="Roadmap item">
        <Badge label={content.roadmapLabel} tone="soon" />
        <p class="ig-roadmap-note">{content.roadmapNote}</p>
      </aside>
    </Reveal>

  </div>
</section>

<style>
  .ig-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
  }

  .ig-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding: 80px 48px 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* ── Engines: two-column layout ── */
  .ig-engines {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .ig-engine-reveal {
    display: contents;
  }

  .ig-engine-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px 28px;
    background: var(--color-soft);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    transition: border-color 0.15s ease;
  }

  .ig-engine-card:hover {
    border-color: var(--color-ink-2);
  }

  .ig-engine-icon {
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-2);
    flex-shrink: 0;
  }

  .ig-engine-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ig-engine-name {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.2;
  }

  .ig-engine-body {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.65;
  }

  /* ── Capabilities ── */
  .ig-capabilities {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ig-cap-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-faint);
    margin: 0;
  }

  .ig-cap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .ig-cap-reveal {
    display: contents;
  }

  .ig-cap-item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    transition: border-color 0.15s ease;
  }

  .ig-cap-item:hover {
    border-color: var(--color-ink-2);
  }

  .ig-cap-icon {
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .ig-cap-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ig-cap-title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.25;
  }

  .ig-cap-body {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Roadmap callout: Codex coming ── */
  .ig-roadmap {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px 20px;
    background: var(--color-soft);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
  }

  .ig-roadmap-note {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.55;
    padding-top: 1px;
  }

  /* ── Responsive ── */

  @media (max-width: 1023px) {
    .ig-container {
      padding: 64px 32px 80px;
      gap: 40px;
    }

    .ig-cap-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .ig-container {
      padding: 48px 16px 64px;
      gap: 36px;
    }

    .ig-engines {
      grid-template-columns: 1fr;
    }

    .ig-engine-card {
      padding: 24px 20px;
    }

    .ig-cap-grid {
      grid-template-columns: 1fr;
    }

    .ig-roadmap {
      flex-direction: column;
      gap: 8px;
    }
  }

  @media (max-width: 480px) {
    .ig-container {
      padding: 36px 12px 52px;
    }
  }
</style>
