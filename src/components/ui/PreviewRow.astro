---
/** PreviewRow.astro: one list row inside the product preview (helper mascot or icon, title, meta, status chip). */
import type { PreviewRow } from '../../data/types';
import Mascot from './Mascot.astro';
import Icon from './Icon.astro';
interface Props { row: PreviewRow }
const { row } = Astro.props;
---
<div class="item">
  <div class="h">
    {row.mascot ? <Mascot name={row.mascot} size={32} /> : <span class="ic"><Icon name={row.icon ?? 'docs'} /></span>}
    <div class="t"><b>{row.title}</b><span>{row.meta}</span></div>
    <span class={`chip ${row.tone}`}>{row.status}</span>
  </div>
</div>
<style>
  .item { border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); }
  .h { padding: 10px 12px; display: flex; gap: 10px; align-items: center; }
  .ic { width: 32px; height: 32px; flex: none; border-radius: 10px; background: var(--soft); border: 1px solid var(--line); display: grid; place-items: center; color: var(--ink-2); }
  .t { flex: 1; min-width: 0; }
  .t b { display: block; font-weight: 500; font-size: 14px; }
  .t span { display: block; font-size: 13px; color: var(--muted); overflow-wrap: anywhere; }
</style>
