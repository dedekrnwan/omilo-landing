---
import Base from '../../layouts/Base.astro';
import { getContent } from '../../i18n';

import Nav from '../../components/sections/Nav.astro';
import Hero from '../../components/sections/Hero.astro';
import SocialProof from '../../components/sections/SocialProof.astro';
import AgentsTeam from '../../components/sections/AgentsTeam.astro';
import ApprovalLoop from '../../components/sections/ApprovalLoop.astro';
import Features from '../../components/sections/Features.astro';
import Integrations from '../../components/sections/Integrations.astro';
import MultiCompany from '../../components/sections/MultiCompany.astro';
import HowItWorks from '../../components/sections/HowItWorks.astro';
import Pricing from '../../components/sections/Pricing.astro';
import Faq from '../../components/sections/Faq.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import Footer from '../../components/sections/Footer.astro';

const locale = 'id';
const content = getContent(locale);
---

<Base
  title={content.meta.title}
  description={content.meta.description}
  locale={locale}
  ogImageAlt={content.meta.ogImageAlt}
>
  <Nav content={content.nav} locale={locale} />
  <main>
    <Hero content={content.hero} locale={locale} />
    <SocialProof content={content.socialProof} locale={locale} />
    <AgentsTeam content={content.agents} locale={locale} />
    <ApprovalLoop content={content.approvalLoop} locale={locale} />
    <Features content={content.features} locale={locale} />
    <Integrations content={content.integrations} locale={locale} />
    <MultiCompany content={content.multiCompany} locale={locale} />
    <HowItWorks content={content.howItWorks} locale={locale} />
    <Pricing content={content.pricing} locale={locale} />
    <Faq content={content.faq} locale={locale} />
    <FinalCta content={content.finalCta} locale={locale} />
  </main>
  <Footer content={content.footer} locale={locale} />
</Base>
