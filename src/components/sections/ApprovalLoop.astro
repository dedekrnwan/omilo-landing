---
/**
 * ApprovalLoop.astro — "Who is in charge" section.
 *
 * Props: content (Content['approvalLoop']), locale (Locale).
 *
 * Design notes:
 *   - 3-step flow: Propose -> Decide (Inbox) -> Execute in code.
 *     Steps rendered horizontally with inline-SVG connectors on desktop,
 *     vertically stacked on mobile.
 *   - Policy levels as chips using status tint tokens:
 *       off       -> neutral/muted (no tint, just line border)
 *       ask       -> warn-tint (amber)
 *       do_and_tell -> info-tint (blue)
 *       auto      -> ok-tint (green)
 *   - strict-mode note rendered verbatim from content.strictNote.
 *   - guarantee rendered as a footnote line.
 *   - All copy from content. No hardcoded user-facing text. No em dashes.
 *   - Flat/minimal; no glow, no shadow on steps, no decorative dots.
 *   - Reveal stagger on steps and chips.
 */
import type { ApprovalLoopContent } from '../../data/types';
import type { Locale } from '../../i18n';
import Reveal from '../ui/Reveal.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  content: ApprovalLoopContent;
  locale: Locale;
}

// locale is reserved for future i18n use.
const { content, locale: _locale } = Astro.props;

// Inline-SVG icons for the three steps. Flat, thin stroke, no fill glow.
// Propose: document with pencil
// Decide: inbox tray
// Execute: terminal/code brackets
const stepIcons = [
  // Propose — document with a pencil mark
  `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
    <rect x="5" y="3" width="15" height="19" rx="2" stroke="currentColor" stroke-width="1.5"/>
    <path d="M8 8h9M8 12h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M18 18.5l2.5-2.5 1.5 1.5-2.5 2.5H18v-1.5z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
  </svg>`,
  // Decide — inbox tray with check
  `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
    <rect x="3" y="14" width="22" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/>
    <path d="M3 14l4-11h14l4 11" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    <path d="M10 19.5l2.5 2.5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`,
  // Execute — code brackets
  `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
    <path d="M10 8L4 14l6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M18 8l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M16 6l-4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  </svg>`,
];

// Arrow connector SVG (horizontal, used between steps on desktop)
const arrowSVG = `<svg width="36" height="20" viewBox="0 0 36 20" fill="none" aria-hidden="true" focusable="false" class="al-arrow">
  <path d="M2 10h28M24 4l8 6-8 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>`;

// Vertical connector SVG (used between steps on mobile)
const arrowDownSVG = `<svg width="20" height="32" viewBox="0 0 20 32" fill="none" aria-hidden="true" focusable="false" class="al-arrow-down">
  <path d="M10 2v22M4 18l6 8 6-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>`;

// Policy chip appearance: maps the level string to a CSS class suffix.
// Matching is done case-insensitively on the first word of level.
function getPolicyClass(level: string): string {
  const key = level.toLowerCase().replace(/\s+/g, '_');
  if (key === 'auto') return 'al-chip--ok';
  if (key === 'ask') return 'al-chip--warn';
  if (key === 'do_and_tell') return 'al-chip--info';
  return 'al-chip--off'; // 'off' or unknown
}
---

<section id="approval-loop" class="al-section">
  <div class="al-container">

    {/* Section header */}
    <Reveal>
      <SectionHeader
        eyebrow={content.eyebrow}
        title={content.heading}
        subtitle={content.subhead}
      />
    </Reveal>

    {/* 3-step flow */}
    <div class="al-flow" role="list">
      {content.steps.map((step, i) => (
        <>
          <Reveal delay={80 + i * 90} class="al-step-reveal">
            <article class="al-step" role="listitem">
              <div class="al-step-icon" aria-hidden="true" set:html={stepIcons[i] ?? stepIcons[0]} />
              <div class="al-step-body">
                <span class="al-step-num" aria-hidden="true">{i + 1}</span>
                <h3 class="al-step-title">{step.title}</h3>
                <p class="al-step-body-text">{step.body}</p>
              </div>
            </article>
          </Reveal>
          {i < content.steps.length - 1 && (
            <>
              <span class="al-connector-h" aria-hidden="true" set:html={arrowSVG} />
              <span class="al-connector-v" aria-hidden="true" set:html={arrowDownSVG} />
            </>
          )}
        </>
      ))}
    </div>

    {/* Policy model */}
    <Reveal delay={360}>
      <div class="al-policy">
        <h3 class="al-policy-heading">{content.policyHeading}</h3>
        <div class="al-chips" role="list">
          {content.policyLevels.map((pl, i) => (
            <Reveal delay={400 + i * 60} class="al-chip-reveal">
              <div class={['al-chip', getPolicyClass(pl.level)].join(' ')} role="listitem">
                <span class="al-chip-level">{pl.level}</span>
                <span class="al-chip-body">{pl.body}</span>
              </div>
            </Reveal>
          ))}
        </div>

        {/* Strict mode trust line */}
        <div class="al-strict">
          {/* Shield icon */}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="al-strict-icon">
            <path d="M8 2L3 4v4c0 3 2.5 5.5 5 6.5C11.5 13.5 14 11 14 8V4L8 2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
            <path d="M5.5 8l2 2 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p class="al-strict-text">{content.strictNote}</p>
        </div>
      </div>
    </Reveal>

    {/* Guarantee footnote */}
    <Reveal delay={560}>
      <p class="al-guarantee">{content.guarantee}</p>
    </Reveal>

  </div>
</section>

<style>
  .al-section {
    background: var(--color-soft);
    border-top: 1px solid var(--color-line);
  }

  .al-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding: 80px 48px 96px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* ── 3-step flow ── */
  .al-flow {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  /* Reveal wrapper passes through as a flex item */
  .al-step-reveal {
    flex: 1;
    min-width: 0;
  }

  .al-step {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px 28px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    height: 100%;
  }

  .al-step-icon {
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-2);
    flex-shrink: 0;
    background: var(--color-app);
  }

  .al-step-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .al-step-num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-faint);
    letter-spacing: 0.04em;
  }

  .al-step-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.2;
  }

  .al-step-body-text {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* Arrow connectors */
  .al-connector-h {
    display: flex;
    align-items: center;
    align-self: center;
    color: var(--color-faint);
    flex-shrink: 0;
    padding: 0 4px;
  }

  .al-connector-v {
    display: none;
    color: var(--color-faint);
    align-self: center;
    margin: 0 auto;
  }

  /* ── Policy model ── */
  .al-policy {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .al-policy-heading {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
  }

  /* Chips grid: 4 columns on desktop, 2 on tablet, 1 on mobile */
  .al-chips {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .al-chip-reveal {
    display: contents;
  }

  .al-chip {
    border-radius: var(--radius-md);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1px solid transparent;
  }

  /* off: neutral muted */
  .al-chip--off {
    background: var(--color-app);
    border-color: var(--color-line);
  }
  .al-chip--off .al-chip-level {
    color: var(--color-ink-2);
  }

  /* ask: warn tint */
  .al-chip--warn {
    background: var(--color-warn-tint);
    border-color: color-mix(in srgb, var(--color-warn) 20%, transparent);
  }
  .al-chip--warn .al-chip-level {
    color: var(--color-warn);
  }

  /* do_and_tell: info tint */
  .al-chip--info {
    background: var(--color-info-tint);
    border-color: color-mix(in srgb, var(--color-info) 20%, transparent);
  }
  .al-chip--info .al-chip-level {
    color: var(--color-info);
  }

  /* auto: ok tint */
  .al-chip--ok {
    background: var(--color-ok-tint);
    border-color: color-mix(in srgb, var(--color-ok) 20%, transparent);
  }
  .al-chip--ok .al-chip-level {
    color: var(--color-ok);
  }

  .al-chip-level {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .al-chip-body {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--color-ink-2);
    line-height: 1.5;
  }

  /* Strict mode note */
  .al-strict {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 14px 16px;
    background: var(--color-app);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
  }

  .al-strict-icon {
    color: var(--color-ink-2);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .al-strict-text {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--color-ink-2);
    margin: 0;
    line-height: 1.55;
  }

  /* Guarantee footnote */
  .al-guarantee {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
    border-top: 1px solid var(--color-line);
    padding-top: 20px;
    max-width: 72ch;
  }

  /* ── Responsive ── */

  @media (max-width: 1023px) {
    .al-container {
      padding: 64px 32px 80px;
      gap: 44px;
    }

    .al-chips {
      grid-template-columns: repeat(2, 1fr);
    }

    .al-policy {
      padding: 28px 24px;
    }
  }

  @media (max-width: 767px) {
    /* Stack steps vertically */
    .al-flow {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .al-step-reveal {
      flex: none;
    }

    .al-connector-h {
      display: none;
    }

    .al-connector-v {
      display: flex;
    }
  }

  @media (max-width: 640px) {
    .al-container {
      padding: 48px 16px 64px;
      gap: 36px;
    }

    .al-step {
      padding: 24px 20px;
    }

    .al-chips {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .al-container {
      padding: 36px 12px 52px;
    }
  }
</style>
