---
/** Footer.astro: brand, early-access note, contact and source links. */
import type { Content } from '../../data/types';
import { localizePath, type Locale } from '../../i18n';
import { REPO_URL } from '../../config';
import Mascot from '../ui/Mascot.astro';
interface Props { content: Content['footer']; locale: Locale; brand: string; homeAriaLabel: string }
const { content, locale, brand, homeAriaLabel } = Astro.props;
---
<footer>
  <div class="wrap row">
    <a class="brand" href={localizePath('/', locale)} aria-label={homeAriaLabel}><Mascot name="brand" size={22} /><b>{brand}</b><span>{content.tagline}</span></a>
    <nav class="links" aria-label="Footer">
      <span>{content.contactLabel}: <a href={`mailto:${content.email}`}>{content.email}</a></span>
      <a href={REPO_URL} target="_blank" rel="noopener">{content.sourceLabel}</a>
    </nav>
  </div>
  <div class="wrap row small"><span>{content.note}</span><span>{content.copyright}</span></div>
</footer>
<style>
  footer { border-top: 1px solid var(--line); padding-block: 20px; font-size: 13px; color: var(--muted); display: grid; gap: 10px; }
  .row { width: 100%; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; align-items: center; }
  .brand { display: flex; align-items: center; gap: 8px; color: var(--ink); }
  .brand:hover { text-decoration: none; }
  .brand b { font: 600 14px/1 var(--font-display); }
  .brand span { color: var(--muted); }
  .links { display: flex; gap: 16px; flex-wrap: wrap; }
  .small { font-size: 12px; }
</style>
