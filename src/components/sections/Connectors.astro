---
/**
 * Connectors.astro: the apps helpers can reach, drawn as a live field.
 * Helpers (mascots) and app tiles float on a soft field; wires join each helper to
 * the apps it uses. Every couple of seconds one helper "uses" an app: a pulse runs
 * down the wire, the app pings, the helper hops and a toast says what happened.
 * Apps match the real catalog.
 * Motion pauses off-screen and is off under prefers-reduced-motion.
 */
import type { Content, ConnectorKey, MascotKey } from '../../data/types';
import Mascot from '../ui/Mascot.astro';
import BrandIcon from '../ui/BrandIcon.astro';
interface Props { content: Content['connectors'] }
const { content } = Astro.props;

/* Layout only (no copy): [col, row] on the 16x6 desktop grid, [col, row] on the 7x9 phone grid. */
type Pos = { d: [number, number]; m?: [number, number] };
const HELPER_POS: Partial<Record<MascotKey, Pos>> = {
  chief: { d: [7, 1], m: [3, 1] },
  support: { d: [3, 3], m: [1, 4] },
  marketing: { d: [5, 4], m: [2, 6] },
  finance: { d: [10, 3], m: [5, 4] },
  sales: { d: [8, 4], m: [4, 6] },
  ops: { d: [12, 1], m: [5, 1] },
  dev: { d: [13, 4], m: [5, 7] },
};
const APP_POS: Record<ConnectorKey, Pos> = {
  gmail: { d: [5, 2], m: [2, 2] },
  gcal: { d: [9, 0], m: [1, 0] },
  gsheets: { d: [11, 4], m: [6, 5] },
  whatsapp: { d: [1, 4], m: [0, 6] },
  instagram: { d: [2, 5], m: [1, 7] },
  facebook: { d: [6, 5], m: [3, 8] },
  zapier: { d: [11, 0], m: [6, 0] },
  github: { d: [15, 4], m: [6, 8] },
  postgres: { d: [15, 1], m: [6, 2] },
  browser: { d: [13, 2], m: [4, 3] },
  mcp: { d: [14, 5], m: [4, 8] },
};
const GHOSTS: Pos[] = [
  { d: [1, 0], m: [0, 1] }, { d: [3, 1] }, { d: [0, 3], m: [0, 3] }, { d: [12, 5] }, { d: [15, 0] }, { d: [8, 2], m: [3, 4] },
];

const pos = (p: Pos, i: number) => {
  const [c, r] = p.d;
  const [mc, mr] = p.m ?? [-9, -9];
  return `--c:${c};--r:${r};--mc:${mc};--mr:${mr};--d:${(-((i * 0.83) % 6)).toFixed(2)}s`;
};
const appName = Object.fromEntries(content.apps.map((a) => [a.key, a.name]));
const helperName = Object.fromEntries(content.helpers.map((h) => [h.mascot, h.name]));
const activity = content.activity
  .filter((a) => HELPER_POS[a.mascot] && APP_POS[a.app])
  .map((a) => ({ m: a.mascot, a: a.app, who: helperName[a.mascot] ?? a.mascot, app: appName[a.app] ?? a.app, text: a.text, ask: !!a.ask }));
const links = [...new Set(activity.map((a) => `${a.m}>${a.a}`))];
let i = 0;
---
<section class="block" id="connectors" aria-labelledby="connectors-h">
  <div class="wrap">
    <div class="head">
      <div>
        <div class="eyebrow">{content.eyebrow}</div>
        <h2 id="connectors-h">{content.heading}</h2>
      </div>
      <div class="side">
        <p>{content.subhead}</p>
        <button type="button" class="more" data-open="waitlist">{content.cta}<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
    </div>

    <div
      class="field"
      data-connectors
      data-activity={JSON.stringify(activity)}
      data-links={JSON.stringify(links)}
      data-ask={content.askChip}
      data-auto={content.autoChip}
    >
      <div class="sky" aria-hidden="true"></div>
      <svg class="wires" aria-hidden="true"></svg>
      <ul class="tiles">
        {content.helpers.filter((h) => HELPER_POS[h.mascot]).map((h) => (
          <li class={`t helper${HELPER_POS[h.mascot]!.m ? '' : ' dk'}`} data-m={h.mascot} style={pos(HELPER_POS[h.mascot]!, i++)}>
            <span class="float"><span class="face"><Mascot name={h.mascot} size={60} /></span></span>
            <span class="nm">{h.name}</span>
          </li>
        ))}
        {content.apps.filter((a) => APP_POS[a.key]).map((a) => (
          <li class={`t app${APP_POS[a.key].m ? '' : ' dk'}`} data-a={a.key} style={pos(APP_POS[a.key], i++)}>
            <span class="float"><span class="face"><BrandIcon name={a.key} size={26} /></span></span>
            <span class="nm">{a.name}</span>
          </li>
        ))}
        {GHOSTS.map((g) => (
          <li class={`t ghost${g.m ? '' : ' dk'}`} aria-hidden="true" style={pos(g, i++)}>
            <span class="float"><span class="face"><svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span></span>
            <span class="nm">{content.addLabel}</span>
          </li>
        ))}
      </ul>
      <div class="toast" aria-hidden="true"><div class="tw"><b></b><span class="arr">→</span><span class="ta"></span></div><p></p><span class="chip"></span></div>
    </div>

    <div class="feats">
      {content.features.map((f) => (
        <div class="feat"><h3>{f.title}</h3><p>{f.body}</p></div>
      ))}
    </div>
  </div>
</section>

<style>
  .head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 24px 48px; align-items: start; margin-bottom: 40px; }
  .eyebrow { font: 500 12px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .head h2 { font: 500 clamp(34px, 4.6vw, 56px)/1.04 var(--font-display); letter-spacing: -.03em; margin-top: 14px; max-width: 13ch; }
  .side { padding-top: 26px; max-width: 520px; justify-self: end; }
  .side p { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.45; color: var(--ink-2); }
  .more { display: inline-flex; align-items: center; gap: 4px; margin-top: 20px; padding: 0; border: 0; background: none; font-size: 15px; font-weight: 500; color: var(--ink); }
  .more svg { transition: transform .2s; }
  .more:hover svg { transform: translateX(3px); }

  /* the field */
  .field {
    --cols: 16; --rows: 6; --tile: 52px; --helper: 60px;
    position: relative; height: 470px; border-radius: 24px; overflow: hidden; isolation: isolate;
    border: 1px solid var(--line-strong); background: var(--field-base);
    box-shadow: 0 1px 0 rgba(255,255,255,.8) inset, 0 30px 60px -40px rgba(28, 25, 23, .35);
  }
  .sky { position: absolute; inset: -20%; z-index: -2; background:
      radial-gradient(38% 46% at 14% 18%, var(--field-indigo), transparent 70%),
      radial-gradient(34% 44% at 82% 10%, var(--field-sky), transparent 70%),
      radial-gradient(46% 40% at 52% 96%, var(--field-sage), transparent 70%),
      radial-gradient(30% 40% at 96% 86%, var(--field-amber), transparent 70%),
      radial-gradient(26% 34% at 4% 92%, var(--field-rose), transparent 70%);
  }
  .field::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(rgba(12, 10, 9, .09) 1px, transparent 1.3px) 0 0 / 22px 22px;
    -webkit-mask: radial-gradient(80% 90% at 50% 50%, #000 30%, transparent 85%); mask: radial-gradient(80% 90% at 50% 50%, #000 30%, transparent 85%); }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; overflow: visible; }
  .wires :global(path) { fill: none; stroke: var(--wire); stroke-width: 1.4; stroke-dasharray: 3 6; stroke-linecap: round; transition: stroke .3s, stroke-width .3s, opacity .3s; }
  .wires :global(path.hl) { stroke: var(--pc); stroke-width: 2; stroke-dasharray: none; }
  .wires :global(circle) { fill: var(--pc); filter: drop-shadow(0 0 6px var(--pc)); }
  .field.focus .wires :global(path:not(.hl)) { opacity: .25; }

  .tiles { list-style: none; margin: 0; padding: 0; position: absolute; inset: 22px 28px; z-index: 1; }
  .t { position: absolute; left: calc((var(--c) + .5) / var(--cols) * 100%); top: calc((var(--r) + .5) / var(--rows) * 100%);
    transform: translate(-50%, -50%); transition: opacity .3s; }
  .float { display: block; }
  .face { display: grid; place-items: center; width: var(--tile); height: var(--tile); border-radius: 14px; background: var(--surface);
    border: 1px solid var(--line-strong); box-shadow: 0 1px 2px rgba(28,25,23,.06), 0 8px 18px -10px rgba(28,25,23,.28);
    transition: transform .25s cubic-bezier(.3, 1.4, .5, 1), box-shadow .25s; position: relative; }
  .helper .face { width: var(--helper); height: var(--helper); border-radius: 17px; padding: 0; overflow: visible; border-color: transparent; }
  .helper .face :global(svg.mascot) { width: 100%; height: 100%; cursor: pointer; }
  .ghost .face { background: rgba(255, 255, 255, .35); border: 1.5px dashed var(--wire-strong); box-shadow: none; color: var(--faint); }
  .t:hover .face { transform: translateY(-3px) scale(1.07); box-shadow: 0 2px 4px rgba(28,25,23,.08), 0 16px 28px -12px rgba(28,25,23,.35); }
  .nm { position: absolute; left: 50%; top: calc(100% + 8px); transform: translate(-50%, -4px); white-space: nowrap; pointer-events: none;
    font-size: 12px; font-weight: 500; color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong);
    padding: 3px 8px; border-radius: 999px; opacity: 0; transition: opacity .18s, transform .18s; z-index: 3; box-shadow: var(--shadow-float); }
  .t:hover .nm { opacity: 1; transform: translate(-50%, 0); }
  .t:hover { z-index: 4; }
  .field.focus .t.dim { opacity: .35; }

  /* the ping when a helper uses an app */
  .face::after { content: ''; position: absolute; inset: -1px; border-radius: inherit; border: 2px solid var(--pc, transparent); opacity: 0; pointer-events: none; }
  .t.ping .face::after { animation: ping .9s ease-out; }
  .t.ping .face { box-shadow: 0 0 0 4px color-mix(in srgb, var(--pc) 18%, transparent), 0 16px 28px -12px rgba(28,25,23,.35); }
  @keyframes ping { 0% { opacity: .9; transform: scale(1); } 100% { opacity: 0; transform: scale(1.55); } }

  .toast { position: absolute; z-index: 5; left: 0; top: 0; min-width: 190px; max-width: 250px; padding: 10px 12px; border-radius: 12px; pointer-events: none;
    background: rgba(255, 255, 255, .92); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--line-strong); box-shadow: 0 18px 30px -16px rgba(28,25,23,.4);
    opacity: 0; transform: translate(-50%, calc(-100% - 6px)) scale(.96); transition: opacity .25s, transform .3s cubic-bezier(.3, 1.4, .5, 1); }
  .toast.below { transform: translate(-50%, 6px) scale(.96); }
  .toast.on { opacity: 1; transform: translate(-50%, calc(-100% - 14px)) scale(1); }
  .toast.below.on { transform: translate(-50%, 14px) scale(1); }
  .tw { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); white-space: nowrap; }
  .tw b { color: var(--pc); font-weight: 600; }
  .tw .ta { color: var(--ink-2); font-weight: 500; overflow: hidden; text-overflow: ellipsis; }
  .toast p { font-size: 13px; line-height: 1.35; color: var(--ink); margin: 4px 0 8px; }
  .toast .chip { height: 20px; font-size: 11px; }

  .feats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 40px; }
  .feat { padding: 0 32px; border-left: 1px solid var(--line-strong); }
  .feat:first-child { padding-left: 0; border-left: 0; }
  .feat h3 { font-size: 18px; font-weight: 600; letter-spacing: -.01em; }
  .feat p { margin-top: 10px; color: var(--ink-2); font-size: 15px; line-height: 1.6; }

  @media (prefers-reduced-motion: no-preference) {
    .float { animation: bob 6s ease-in-out infinite; animation-delay: var(--d); }
    .sky { animation: drift 28s ease-in-out infinite alternate; }
    .wires :global(path) { animation: march 1.6s linear infinite; }
    .wires :global(path.hl) { animation: none; }
  }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @keyframes drift { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(4%, -3%) scale(1.06); } }
  @keyframes march { to { stroke-dashoffset: -18; } }

  @media (max-width: 1100px) {
    .field { --tile: 44px; --helper: 52px; height: 420px; }
    .face { border-radius: 12px; }
    .face :global(svg.brand) { width: 22px; height: 22px; }
  }
  @media (max-width: 860px) {
    .head { grid-template-columns: 1fr; margin-bottom: 28px; }
    .side { justify-self: start; padding-top: 0; }
    .feats { grid-template-columns: 1fr; gap: 22px; margin-top: 28px; }
    .feat, .feat:first-child { padding: 0 0 0 16px; border-left: 2px solid var(--line-strong); }
  }
  @media (max-width: 640px) {
    .field { --cols: 7; --rows: 9; --tile: 42px; --helper: 50px; height: 540px; border-radius: 20px; }
    .tiles { inset: 16px 12px; }
    .t { left: calc((var(--mc) + .5) / var(--cols) * 100%); top: calc((var(--mr) + .5) / var(--rows) * 100%); }
    .t.dk { display: none; }
    .toast { min-width: 170px; max-width: 220px; }
  }
</style>

<script>
  type Act = { m: string; a: string; who: string; app: string; text: string; ask: boolean };
  const NS = 'http://www.w3.org/2000/svg';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-connectors]').forEach((field) => {
    const acts: Act[] = JSON.parse(field.dataset.activity || '[]');
    const links: string[] = JSON.parse(field.dataset.links || '[]');
    const svg = field.querySelector<SVGSVGElement>('.wires')!;
    const toast = field.querySelector<HTMLElement>('.toast')!;
    const helper = (m: string) => field.querySelector<HTMLElement>(`.t[data-m="${m}"]`);
    const app = (a: string) => field.querySelector<HTMLElement>(`.t[data-a="${a}"]`);
    const colorOf = (m: string) => helper(m)?.querySelector('.m-char > *')?.getAttribute('fill') || '#6366f1';
    const shown = (el: HTMLElement | null) => !!el && el.offsetParent !== null;
    const paths = new Map<string, SVGPathElement>();

    // Draw one curved wire per helper/app pair, from the tiles' real centres.
    const draw = () => {
      const box = field.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
      svg.replaceChildren();
      paths.clear();
      for (const key of links) {
        const [m, a] = key.split('>');
        const h = helper(m), p = app(a);
        if (!shown(h) || !shown(p)) continue;
        const r1 = h!.getBoundingClientRect(), r2 = p!.getBoundingClientRect();
        const x1 = r1.left + r1.width / 2 - box.left, y1 = r1.top + r1.height / 2 - box.top;
        const x2 = r2.left + r2.width / 2 - box.left, y2 = r2.top + r2.height / 2 - box.top;
        const dx = x2 - x1, dy = y2 - y1, bend = 0.18;
        const cx = (x1 + x2) / 2 - dy * bend, cy = (y1 + y2) / 2 + dx * bend;
        const path = document.createElementNS(NS, 'path');
        path.setAttribute('d', `M${x1.toFixed(1)} ${y1.toFixed(1)} Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`);
        path.style.setProperty('--pc', colorOf(m));
        path.dataset.m = m; path.dataset.a = a;
        svg.appendChild(path);
        paths.set(key, path);
      }
    };

    // Hover a helper or an app: light up its wires, dim the rest.
    const focus = (m?: string, a?: string) => {
      if (!m && !a) {
        field.classList.remove('focus');
        field.querySelectorAll('.t.dim').forEach((t) => t.classList.remove('dim'));
        paths.forEach((p) => p.classList.remove('hl'));
        return;
      }
      const keep = new Set<string>();
      paths.forEach((p, key) => {
        const on = (m && p.dataset.m === m) || (a && p.dataset.a === a);
        p.classList.toggle('hl', !!on);
        if (on) { keep.add('m:' + p.dataset.m); keep.add('a:' + p.dataset.a); }
      });
      field.classList.add('focus');
      field.querySelectorAll<HTMLElement>('.t').forEach((t) => {
        const id = t.dataset.m ? 'm:' + t.dataset.m : t.dataset.a ? 'a:' + t.dataset.a : '';
        t.classList.toggle('dim', !keep.has(id));
      });
    };
    let hovering = false;
    field.querySelectorAll<HTMLElement>('.t.helper, .t.app').forEach((t) => {
      t.addEventListener('pointerenter', () => { hovering = true; focus(t.dataset.m, t.dataset.a); });
      t.addEventListener('pointerleave', () => { hovering = false; focus(); });
    });

    // Show what a helper just did, above (or below) the app tile.
    const say = (act: Act, color: string) => {
      const p = app(act.a);
      if (!p) return;
      const box = field.getBoundingClientRect(), r = p.getBoundingClientRect();
      (toast.querySelector('b') as HTMLElement).textContent = act.who;
      (toast.querySelector('.ta') as HTMLElement).textContent = act.app;
      (toast.querySelector('p') as HTMLElement).textContent = act.text;
      const chip = toast.querySelector('.chip') as HTMLElement;
      chip.textContent = act.ask ? field.dataset.ask || '' : field.dataset.auto || '';
      chip.className = 'chip ' + (act.ask ? 'warn' : 'up');
      toast.style.setProperty('--pc', color);
      const half = Math.min(125, box.width / 2 - 8);
      const x = Math.max(half + 8, Math.min(box.width - half - 8, r.left + r.width / 2 - box.left));
      const top = r.top - box.top;
      const below = top < 120;
      toast.classList.toggle('below', below);
      toast.style.left = `${x}px`;
      toast.style.top = `${below ? r.bottom - box.top : top}px`;
      toast.classList.remove('on'); void toast.offsetWidth; toast.classList.add('on');
    };

    const hop = (m: string) => {
      const s = helper(m)?.querySelector('svg.mascot');
      if (!s) return;
      s.classList.remove('hop'); void s.getBoundingClientRect(); s.classList.add('hop');
      setTimeout(() => s.classList.remove('hop'), 520);
    };

    // One activity: pulse travels helper -> app, app pings, toast appears.
    let n = 0, timer = 0, running = false;
    const step = () => {
      if (!running) return;
      const pool = acts.filter((x) => paths.has(`${x.m}>${x.a}`));
      if (!pool.length || hovering || document.hidden) { timer = window.setTimeout(step, 1200); return; }
      const act = pool[n++ % pool.length];
      const path = paths.get(`${act.m}>${act.a}`)!;
      const color = colorOf(act.m);
      hop(act.m);
      path.classList.add('hl');
      const dot = document.createElementNS(NS, 'circle');
      dot.setAttribute('r', '4');
      dot.style.setProperty('--pc', color);
      svg.appendChild(dot);
      const len = path.getTotalLength(), t0 = performance.now(), dur = 900;
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / dur), e = k < .5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
        const pt = path.getPointAtLength(len * e);
        dot.setAttribute('cx', pt.x.toFixed(1)); dot.setAttribute('cy', pt.y.toFixed(1));
        if (k < 1) { requestAnimationFrame(tick); return; }
        dot.remove();
        const target = app(act.a);
        if (target) {
          target.style.setProperty('--pc', color);
          target.classList.remove('ping'); void target.offsetWidth; target.classList.add('ping');
          setTimeout(() => target.classList.remove('ping'), 900);
        }
        say(act, color);
        setTimeout(() => { if (!hovering) path.classList.remove('hl'); }, 700);
        setTimeout(() => toast.classList.remove('on'), 2300);
        timer = window.setTimeout(step, 1500);
      };
      requestAnimationFrame(tick);
    };

    draw();
    let rz = 0;
    new ResizeObserver(() => { cancelAnimationFrame(rz); rz = requestAnimationFrame(draw); }).observe(field);
    if (reduce) return;
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !running) { running = true; timer = window.setTimeout(step, 600); }
      else if (!e.isIntersecting && running) { running = false; clearTimeout(timer); toast.classList.remove('on'); }
    }, { threshold: 0.25 }).observe(field);
  });
</script>
