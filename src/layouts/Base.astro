---
import '../styles/global.css';
import { SITE } from '../config';
import type { Locale } from '../i18n';

import WaitlistDialog from '../components/waitlist/WaitlistDialog.astro';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  ogImageAlt: string;
  canonical?: string;
}

const { title, description, locale, ogImageAlt, canonical } = Astro.props;

const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, Astro.site ?? SITE).toString();
const ogImage = new URL('/og/social-preview.png', Astro.site ?? SITE).toString();

const ogLocale = locale === 'en' ? 'en_US' : 'id_ID';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Omilo',
      url: Astro.site?.toString() ?? SITE,
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Omilo',
      license: 'Open source',
      applicationCategory: 'BusinessApplication',
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site ?? SITE).toString()} />
    <link rel="alternate" hreflang="id" href={new URL('/id/', Astro.site ?? SITE).toString()} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/saga.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />

    <!-- Theme color -->
    <meta name="theme-color" content="#171717" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omilo" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />

    <WaitlistDialog locale={locale} />

    <script>
      // Mascots: eyes follow the cursor, hop on click (same behaviour as the Saga OS app).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        let px = -1e4, py = -1e4, frame = 0;
        const all = () => document.querySelectorAll<SVGSVGElement>('svg.mascot');
        const track = () => {
          frame = 0;
          all().forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.bottom < 0 || r.top > innerHeight || !r.width) return;
            const dx = px - (r.left + r.width / 2), dy = py - (r.top + r.height / 2), d = Math.hypot(dx, dy);
            const reach = Math.max(220, r.width * 5);
            const k = d > reach || d < 1 ? 0 : Math.min(1, d / (r.width * 0.9 + 1)) * (1 - Math.max(0, d - reach * 0.6) / (reach * 0.4));
            el.style.setProperty('--ex', `${(d ? (dx / d) * 4 * k : 0).toFixed(2)}px`);
            el.style.setProperty('--ey', `${(d ? (dy / d) * 3 * k : 0).toFixed(2)}px`);
          });
        };
        addEventListener('pointermove', (e) => { px = e.clientX; py = e.clientY; if (!frame) frame = requestAnimationFrame(track); }, { passive: true });
        document.addEventListener('pointerdown', (e) => {
          const m = (e.target as Element | null)?.closest?.('svg.mascot');
          if (!m) return;
          m.classList.remove('hop'); void m.getBoundingClientRect(); m.classList.add('hop');
          setTimeout(() => m.classList.remove('hop'), 520);
        }, { passive: true });
      }
    </script>
  </body>
</html>
