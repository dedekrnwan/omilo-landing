---
/**
 * LanguageSwitcher.astro
 * Compact EN | ID locale toggle for the nav bar.
 * Props: locale (Locale) — marks the active locale, links to the other.
 */
import type { Locale } from '../../i18n';
import { localizePath, otherLocale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const other = otherLocale(locale);
const otherHref = localizePath('/', other);

const labels: Record<Locale, string> = { en: 'EN', id: 'ID' };

// Localized aria strings: avoids hardcoded English on /id/.
const currentLangLabel: Record<Locale, string> = {
  en: 'Current language: EN',
  id: 'Bahasa aktif: ID',
};
const switchToLabel: Record<Locale, string> = {
  en: 'Switch to ID',
  id: 'Ganti ke EN',
};
---

<div class="lang-switcher" role="navigation" aria-label="Language">
  <span
    class="lang-item lang-item--active"
    aria-current="true"
    aria-label={currentLangLabel[locale]}
  >
    {labels[locale]}
  </span>
  <span class="lang-divider" aria-hidden="true">|</span>
  <a
    href={otherHref}
    class="lang-item lang-item--link"
    aria-label={switchToLabel[locale]}
    hreflang={other}
  >
    {labels[other]}
  </a>
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-sans);
  }

  .lang-item {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .lang-item--active {
    color: var(--color-ink);
    cursor: default;
  }

  .lang-divider {
    font-size: 11px;
    color: var(--color-line);
    user-select: none;
    line-height: 1;
  }

  .lang-item--link {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .lang-item--link:hover {
    color: var(--color-ink);
  }

  .lang-item--link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
