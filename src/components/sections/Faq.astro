---
/**
 * Faq.astro -- "Questions" section.
 *
 * Props: content (Content['faq']), locale (Locale).
 * Root id="faq" -- must match the Nav link href="#faq".
 *
 * Renders:
 *   - Section header (eyebrow, heading) from slice.
 *   - All items as native <details>/<summary> accordion (keyboard-accessible,
 *     no JS, built-in focus). Each item renders q (summary) + a (body).
 *   - Visible :focus-visible on summary; animated chevron via CSS.
 *
 * Design notes:
 *   - Native details/summary: keyboard-accessible out of the box, works without JS.
 *   - Chevron rotates on open via CSS [open] selector.
 *   - Flat/minimal: border-line separators, no shadow, no glow.
 *   - Stone bg (--color-surface) alternating with Pricing.
 *   - All copy from content. No hardcoded strings. No em dashes.
 */
import type { FaqContent } from '../../data/types';
import type { Locale } from '../../i18n';
import Reveal from '../ui/Reveal.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  content: FaqContent;
  locale: Locale;
}

// locale reserved for future i18n use.
const { content, locale: _locale } = Astro.props;
---

<section id="faq" class="faq-section">
  <div class="faq-container">

    {/* Section header */}
    <Reveal>
      <SectionHeader
        eyebrow={content.eyebrow}
        title={content.heading}
      />
    </Reveal>

    {/* Accordion */}
    <div class="faq-list" role="list">
      {content.items.map((item, i) => (
        <Reveal delay={80 + i * 70}>
          <details class="faq-item">
            <summary class="faq-summary">
              <span class="faq-q">{item.q}</span>
              <span class="faq-chevron" aria-hidden="true">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 18 18"
                  fill="none"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M4.5 6.75L9 11.25L13.5 6.75"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </summary>
            <div class="faq-answer">
              <p class="faq-a">{item.a}</p>
            </div>
          </details>
        </Reveal>
      ))}
    </div>

  </div>
</section>

<style>
  .faq-section {
    background: var(--color-app);
    border-top: 1px solid var(--color-line);
  }

  .faq-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding: 80px 48px 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* ── Accordion list ── */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 760px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* ── Each item ── */
  .faq-item {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  /* ── Summary (clickable row) ── */
  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    /* Remove default marker in WebKit */
    -webkit-appearance: none;
    appearance: none;
    /* Transition for background on hover */
    transition: background-color 0.15s ease;
  }

  /* Remove default triangle marker */
  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary::marker {
    content: '';
  }

  .faq-summary:hover {
    background: var(--color-soft);
  }

  /* Visible focus ring -- per brief requirement */
  .faq-summary:focus-visible {
    outline: 3px solid var(--color-ink-2);
    outline-offset: -3px;
    border-radius: 0;
    background: var(--color-soft);
  }

  .faq-q {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.35;
    flex: 1;
  }

  /* ── Chevron indicator ── */
  .faq-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.15s ease, border-color 0.15s ease;
  }

  /* Rotate chevron when open */
  details[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--color-ink-2);
    border-color: var(--color-ink-2);
  }

  /* ── Answer body ── */
  .faq-answer {
    padding: 0 24px 20px 24px;
    background: var(--color-surface);
  }

  .faq-a {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 400;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.65;
    max-width: 640px;
  }

  /* ── Responsive ── */

  @media (max-width: 1023px) {
    .faq-container {
      padding: 64px 32px 80px;
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .faq-container {
      padding: 48px 16px 64px;
      gap: 36px;
    }

    .faq-summary {
      padding: 16px 18px;
    }

    .faq-q {
      font-size: 15px;
    }

    .faq-answer {
      padding: 0 18px 16px 18px;
    }

    .faq-a {
      font-size: 14px;
    }
  }

  @media (max-width: 480px) {
    .faq-container {
      padding: 36px 12px 52px;
    }

    .faq-summary {
      padding: 14px 14px;
      gap: 12px;
    }

    .faq-answer {
      padding: 0 14px 14px 14px;
    }
  }
</style>
