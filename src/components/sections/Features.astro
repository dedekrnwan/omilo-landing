---
/**
 * Features.astro — "What you get" section.
 *
 * Props: content (Content['features']), locale (Locale).
 *
 * Design notes:
 *   - Feature grid: 7 items (Work, Inbox, Policy, Chat, Workspace, Docs, Monitor).
 *     Desktop: 3-col grid with the first item spanning 2 cols (it is the
 *     structural anchor of the whole Saga OS workflow).
 *     Tablet (<=1023px): 2-col uniform.
 *     Mobile (<=640px): 1-col.
 *   - Each item: inline-SVG icon (relevant to the feature, not generic AI sparkle)
 *     + title + body.
 *   - Reveal stagger across items.
 *   - Flat/minimal. No glow, no shadow, no decorative dots.
 *   - No hardcoded copy. No em dashes.
 */
import type { FeaturesContent } from '../../data/types';
import type { Locale } from '../../i18n';
import Reveal from '../ui/Reveal.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  content: FeaturesContent;
  locale: Locale;
}

// locale is reserved for future i18n use.
const { content, locale: _locale } = Astro.props;

// Inline-SVG icons — one per known feature title.
// Icons are chosen for direct relevance to the feature, not as generic markers.
// Fallback provided for unknown items.
function getFeatureIcon(title: string): string {
  const key = title.toLowerCase();

  if (key === 'work') {
    // Briefcase / tasks icon
    return `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false">
      <rect x="2" y="7" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/>
      <path d="M7 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.4"/>
      <path d="M2 12h18" stroke="currentColor" stroke-width="1.4"/>
      <path d="M9 12v2M13 12v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>`;
  }

  if (key === 'inbox') {
    // Inbox tray
    return `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false">
      <rect x="2" y="11" width="18" height="9" rx="2" stroke="currentColor" stroke-width="1.4"/>
      <path d="M2 11l3.5-9h11L20 11" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <path d="M8 15.5l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`;
  }

  if (key === 'policy') {
    // Shield with sliders
    return `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false">
      <path d="M11 2L3.5 5v5c0 5 3.5 8.5 7.5 10 4-1.5 7.5-5 7.5-10V5L11 2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <path d="M7.5 10h7M7.5 13.5h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <circle cx="14.5" cy="10" r="1.5" fill="currentColor"/>
      <circle cx="12.5" cy="13.5" r="1.5" fill="currentColor"/>
    </svg>`;
  }

  if (key === 'chat') {
    // Chat bubble with a nested smaller bubble
    return `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false">
      <path d="M3 4h11a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H8l-4 3V6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <path d="M16 8h1a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-1" stroke="currentColor" stroke-width="1.4"/>
    </svg>`;
  }

  if (key === 'workspace') {
    // Monitor/screen with play indicator
    return `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false">
      <rect x="2" y="3" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/>
      <path d="M7 19h8M11 15v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <path d="M9 7.5l5 2.5-5 2.5V7.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    </svg>`;
  }

  if (key === 'docs') {
    // Document stack with link
    return `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false">
      <rect x="4" y="2" width="13" height="17" rx="2" stroke="currentColor" stroke-width="1.4"/>
      <path d="M7 7h7M7 10.5h7M7 14h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <path d="M2 5v14a2 2 0 0 0 2 2h12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.4"/>
    </svg>`;
  }

  if (key === 'monitor') {
    // Bar chart with alert dot
    return `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false">
      <path d="M4 18V13M8 18V9M12 18V12M16 18V6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <path d="M2 18h18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <circle cx="18" cy="5" r="2.5" fill="currentColor" opacity="0.7"/>
    </svg>`;
  }

  // Generic fallback: document with lines
  return `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false">
    <rect x="4" y="2" width="14" height="18" rx="2" stroke="currentColor" stroke-width="1.4"/>
    <path d="M7 8h8M7 12h8M7 16h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  </svg>`;
}
---

<section id="features" class="ft-section">
  <div class="ft-container">

    {/* Section header */}
    <Reveal>
      <SectionHeader
        eyebrow={content.eyebrow}
        title={content.heading}
        subtitle={content.subhead}
      />
    </Reveal>

    {/* Feature grid */}
    <div class="ft-grid">
      {content.items.map((item, i) => (
        <Reveal delay={80 + i * 70} class={['ft-item-reveal', i === 0 ? 'ft-item--wide' : ''].filter(Boolean).join(' ')}>
          <article class="ft-item">
            <div class="ft-icon" set:html={getFeatureIcon(item.title)} />
            <div class="ft-text">
              <h3 class="ft-title">{item.title}</h3>
              <p class="ft-body">{item.body}</p>
            </div>
          </article>
        </Reveal>
      ))}
    </div>

  </div>
</section>

<style>
  .ft-section {
    background: var(--color-surface);
    border-top: 1px solid var(--color-line);
  }

  .ft-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding: 80px 48px 96px;
    display: flex;
    flex-direction: column;
    gap: 52px;
  }

  /* ── Feature grid ──
     Desktop: 3-col. First item spans 2 columns for visual hierarchy.
     Tablet: uniform 2-col.
     Mobile: 1-col.
  */
  .ft-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  /* First item spans 2 columns on desktop to signal its weight */
  .ft-item--wide {
    grid-column: span 2;
  }

  .ft-item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 24px;
    background: var(--color-soft);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    transition: border-color 0.15s ease;
  }

  .ft-item:hover {
    border-color: var(--color-ink-2);
  }

  .ft-icon {
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-2);
    flex-shrink: 0;
    background: var(--color-surface);
  }

  .ft-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ft-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.2;
  }

  .ft-body {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Responsive ── */

  @media (max-width: 1023px) {
    .ft-container {
      padding: 64px 32px 80px;
      gap: 40px;
    }

    .ft-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    /* Remove wide span at tablet; uniform 2-col */
    .ft-item--wide {
      grid-column: span 1;
    }
  }

  @media (max-width: 640px) {
    .ft-container {
      padding: 48px 16px 64px;
      gap: 36px;
    }

    .ft-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .ft-item {
      padding: 22px 18px;
    }
  }

  @media (max-width: 480px) {
    .ft-container {
      padding: 36px 12px 52px;
    }
  }
</style>
