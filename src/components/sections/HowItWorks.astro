---
/**
 * HowItWorks.astro -- "Getting started" section.
 *
 * Props: content (Content['howItWorks']), locale (Locale).
 *
 * Renders:
 *   - Section header (eyebrow, heading, subhead) from slice.
 *   - 3 numbered steps with inline-SVG step marks and Reveal stagger.
 *   - Render ALL slice fields (eyebrow, heading, subhead, steps[].title, steps[].body).
 *
 * Design notes:
 *   - Numbered step layout: large flat numeral mark beside each step card.
 *   - Desktop: vertical stacked list with a connector line running between marks.
 *   - Mobile: same stack, narrower padding.
 *   - No glow, no shadow, no decorative dots, no generic AI icons.
 *   - Alternate bg (--color-app) to break rhythm with adjacent sections.
 *   - All copy from content prop. No hardcoded strings. No em dashes.
 */
import type { HowItWorksContent } from '../../data/types';
import type { Locale } from '../../i18n';
import Reveal from '../ui/Reveal.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  content: HowItWorksContent;
  locale: Locale;
}

// locale reserved for future i18n use.
const { content, locale: _locale } = Astro.props;

// Inline-SVG icons per step index -- directly relevant to each action.
// Step 0: onboarding wizard -- a list with a tick mark (form/wizard)
// Step 1: agents run shifts -- a clock face (schedule)
// Step 2: you approve -- an inbox tray with check
const stepIcons = [
  // Step 1: Wizard / form
  `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false">
    <rect x="3" y="2" width="16" height="18" rx="2" stroke="currentColor" stroke-width="1.4"/>
    <path d="M6.5 7h9M6.5 11h9M6.5 15h5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  </svg>`,
  // Step 2: Clock / schedule (agent runs shift)
  `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false">
    <circle cx="11" cy="11" r="8.5" stroke="currentColor" stroke-width="1.4"/>
    <path d="M11 6v5l3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`,
  // Step 3: Inbox tray with checkmark (approve)
  `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true" focusable="false">
    <rect x="2" y="12" width="18" height="8" rx="2" stroke="currentColor" stroke-width="1.4"/>
    <path d="M2 12l3.5-9h11L20 12" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    <path d="M7.5 16.5l2 2 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`,
];
---

<section id="how-it-works" class="hiw-section">
  <div class="hiw-container">

    {/* Section header */}
    <Reveal>
      <SectionHeader
        eyebrow={content.eyebrow}
        title={content.heading}
        subtitle={content.subhead}
      />
    </Reveal>

    {/* Steps */}
    <ol class="hiw-steps" role="list">
      {content.steps.map((step, i) => (
        <Reveal delay={100 + i * 120} class="hiw-step-reveal">
          <li class="hiw-step">

            {/* Step mark: number + connector line */}
            <div class="hiw-mark" aria-hidden="true">
              <div class="hiw-mark-inner">
                <div class="hiw-icon-wrap" set:html={stepIcons[i]} />
                <span class="hiw-num">{i + 1}</span>
              </div>
              {i < content.steps.length - 1 && (
                <div class="hiw-connector" aria-hidden="true" />
              )}
            </div>

            {/* Step content */}
            <div class="hiw-content">
              <h3 class="hiw-title">{step.title}</h3>
              <p class="hiw-body">{step.body}</p>
            </div>

          </li>
        </Reveal>
      ))}
    </ol>

  </div>
</section>

<style>
  .hiw-section {
    background: var(--color-app);
    border-top: 1px solid var(--color-line);
  }

  .hiw-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding: 80px 48px 96px;
    display: flex;
    flex-direction: column;
    gap: 52px;
  }

  /* ── Steps list ── */
  .hiw-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 760px;
  }

  .hiw-step-reveal {
    /* Reveal wrapper passes through the list item layout */
  }

  .hiw-step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 28px;
    align-items: start;
  }

  /* ── Step mark column ──
     Contains the icon + number badge above, and a connector line below
     that visually bridges to the next step.
  */
  .hiw-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Full height so connector line stretches into the space below the card */
    align-self: stretch;
  }

  .hiw-mark-inner {
    position: relative;
    width: 56px;
    height: 56px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-2);
    flex-shrink: 0;
  }

  .hiw-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Step number badge -- top-right corner of the mark */
  .hiw-num {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-on-primary);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    line-height: 20px;
    text-align: center;
    display: block;
  }

  /* Connector line between steps */
  .hiw-connector {
    width: 1px;
    flex: 1;
    margin-top: 8px;
    background: var(--color-line);
    min-height: 32px;
  }

  /* ── Step content column ── */
  .hiw-content {
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Last step: no bottom padding needed after connector */
  .hiw-step:last-child .hiw-content {
    padding-bottom: 0;
  }

  .hiw-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-ink);
    margin: 0;
    line-height: 1.25;
    padding-top: 16px;
  }

  .hiw-body {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 400;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.65;
    max-width: 580px;
  }

  /* ── Responsive ── */

  @media (max-width: 1023px) {
    .hiw-container {
      padding: 64px 32px 80px;
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .hiw-container {
      padding: 48px 16px 64px;
      gap: 36px;
    }

    .hiw-step {
      grid-template-columns: 44px 1fr;
      gap: 16px;
    }

    .hiw-mark-inner {
      width: 44px;
      height: 44px;
    }

    .hiw-title {
      font-size: 17px;
      padding-top: 10px;
    }

    .hiw-body {
      font-size: 14px;
    }
  }

  @media (max-width: 480px) {
    .hiw-container {
      padding: 36px 12px 52px;
    }

    .hiw-step {
      grid-template-columns: 40px 1fr;
      gap: 12px;
    }

    .hiw-mark-inner {
      width: 40px;
      height: 40px;
    }
  }
</style>
