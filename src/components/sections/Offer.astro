---
/** Offer.astro: ways to use Omilo. A 'repo' CTA links to the source; others open the waitlist. */
import type { Content } from '../../data/types';
import { GITHUB_URL } from '../../config';
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';
interface Props { content: Content['offer'] }
const { content } = Astro.props;
---
<section class="block" id="offer" aria-labelledby="offer-h">
  <div class="wrap">
    <SectionHead id="offer-h" eyebrow={content.eyebrow} heading={content.heading} subhead={content.subhead} />
    <div class="plans">
      {content.plans.map((p) => (
        <div class:list={['plan', { hl: p.highlight }]}>
          <span class="chip">{p.label}</span>
          <h3>{p.title}</h3>
          <p class="body">{p.body}</p>
          <ul>{p.points.map((pt) => <li><Icon name="check" />{pt}</li>)}</ul>
          {p.action === 'repo'
            ? <a class:list={['btn lg', { primary: p.highlight }]} href={GITHUB_URL} target="_blank" rel="noopener noreferrer">{p.cta}</a>
            : <button type="button" class:list={['btn lg', { primary: p.highlight }]} data-open="waitlist">{p.cta}</button>}
        </div>
      ))}
    </div>
    <p class="note">{content.note}</p>
  </div>
</section>
<style>
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; align-items: stretch; }
  .plan { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 20px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .plan.hl { border-color: var(--line-strong); box-shadow: 0 24px 40px -32px rgba(28, 25, 23, .45); }
  .plan .chip { align-self: flex-start; }
  .plan.hl .chip { background: var(--primary); border-color: var(--primary); color: #fff; }
  h3 { font: 600 22px/1.2 var(--font-display); letter-spacing: -.015em; margin-top: 4px; }
  .body { font-size: 14px; color: var(--ink-2); }
  ul { list-style: none; margin: 4px 0 8px; padding: 0; display: grid; gap: 8px; flex: 1; }
  li { display: flex; gap: 8px; align-items: flex-start; font-size: 14px; color: var(--ink-2); }
  li :global(.icon) { color: var(--ok); flex: none; margin-top: 3px; width: 14px; height: 14px; }
  .plan .btn { width: 100%; }
  .note { margin-top: 12px; font-size: 13px; color: var(--muted); }
  @media (max-width: 860px) { .plans { grid-template-columns: 1fr; } }
</style>
