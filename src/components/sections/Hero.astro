---
/**
 * Hero.astro — Saga OS landing page hero.
 *
 * Props: content (Content['hero']), locale (Locale).
 *
 * Layout:
 *   Desktop: two-column flex. Left = copy + CTAs. Right = AppShell workspace mock.
 *   Mobile: single column, stacked (copy above, AppShell below, scaled to fit).
 *
 * Design principles (antislop-ui):
 *   - No gradients, no glow, no grid backgrounds, no floating blobs.
 *   - One shadow used once, on the AppShell card (via AppShell itself).
 *   - Headline in font-display (Bricolage Grotesque), large, tight tracking.
 *   - Left-aligned — not centered. Centering everything is slop.
 *   - The AppShell is the visual; it must feel like the real product.
 *
 * All copy from content prop. No hardcoded strings, no em dashes.
 */
import type { HeroContent } from '../../data/types';
import type { Locale } from '../../i18n';
import Reveal from '../ui/Reveal.astro';
import AppShell from '../ui/AppShell.astro';

interface Props {
  content: HeroContent;
  locale: Locale;
}

// locale is reserved for future i18n use (e.g. locale-specific copy variants).
const { content, locale: _locale } = Astro.props;
---

<section class="hero-section bg-surface">
  <div class="hero-container">
    <div class="hero-inner">

      {/* ─── LEFT: Copy + CTAs ─── */}
      <div class="hero-copy">

        <Reveal>
          <h1 class="hero-headline">
            {content.headline}
          </h1>
        </Reveal>

        <Reveal delay={80}>
          <p class="hero-subhead">
            {content.subhead}
          </p>
        </Reveal>

        <Reveal delay={160}>
          <div class="hero-ctas">
            {/* Primary CTA */}
            <a
              href="#"
              data-open="waitlist"
              class="cta-primary"
            >
              {content.ctaPrimary.label}
            </a>

            {/* Secondary CTA — scrolls to #how-it-works */}
            <a
              href="#how-it-works"
              class="cta-secondary"
            >
              {content.ctaSecondary.label}
            </a>
          </div>
        </Reveal>

        <Reveal delay={220}>
          <p class="hero-microcopy">
            {/* Inline check icon */}
            <svg
              width="14"
              height="14"
              viewBox="0 0 14 14"
              fill="none"
              aria-hidden="true"
              class="hero-check"
            >
              <circle cx="7" cy="7" r="6" stroke="var(--color-muted)" stroke-width="1.2"/>
              <path
                d="M4.5 7l1.8 1.8L9.5 5.5"
                stroke="var(--color-muted)"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            {content.microcopy}
          </p>
        </Reveal>

      </div>
      {/* ─── END LEFT ─── */}

      {/* ─── RIGHT: AppShell workspace mock ─── */}
      <Reveal delay={120} class="hero-visual-wrapper">
        <div class="hero-visual-scale">
          <AppShell class="hero-app-shell" />
        </div>
      </Reveal>
      {/* ─── END RIGHT ─── */}

    </div>
  </div>
</section>

<style>
  .hero-section {
    background: var(--color-surface);
  }

  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding: 72px 48px 96px;
  }

  .hero-inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 64px;
  }

  /* ── Copy column ── */
  .hero-copy {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin: 0;
  }

  .hero-subhead {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 0;
    max-width: 52ch;
  }

  /* CTA row */
  .hero-ctas {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 50px;
    padding: 0 28px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s ease;
    flex-shrink: 0;
  }

  .cta-primary:hover {
    opacity: 0.85;
  }

  .cta-primary:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 50px;
    padding: 0 28px;
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease;
    flex-shrink: 0;
  }

  .cta-secondary:hover {
    background: var(--color-soft);
    border-color: var(--color-ink-2);
  }

  .cta-secondary:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* Microcopy */
  .hero-microcopy {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.4;
  }

  .hero-check {
    flex-shrink: 0;
    display: block;
  }

  /* ── Visual column ── */
  .hero-visual-wrapper {
    flex-shrink: 0;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    width: 520px;
  }

  .hero-visual-scale {
    width: 100%;
    transform-origin: top left;
  }

  .hero-app-shell {
    width: 100%;
  }

  /* ── Responsive ── */

  /* Tablet: tighten spacing, scale AppShell */
  @media (max-width: 1100px) {
    .hero-container {
      padding: 56px 32px 72px;
    }

    .hero-inner {
      gap: 40px;
    }

    .hero-headline {
      font-size: 44px;
    }

    .hero-visual-wrapper {
      width: 420px;
    }
  }

  /* Below 1024px: stack vertically */
  @media (max-width: 1023px) {
    .hero-container {
      padding: 48px 24px 64px;
    }

    .hero-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 48px;
    }

    .hero-visual-wrapper {
      width: 100%;
      justify-content: center;
    }

    .hero-visual-scale {
      max-width: 560px;
      margin: 0 auto;
      transform: none;
    }
  }

  /* Mobile: smaller type */
  @media (max-width: 640px) {
    .hero-container {
      padding: 36px 16px 52px;
    }

    .hero-headline {
      font-size: 36px;
      letter-spacing: -0.025em;
    }

    .hero-subhead {
      font-size: 16px;
    }

    .cta-primary,
    .cta-secondary {
      height: 46px;
      padding: 0 22px;
      font-size: 14px;
    }
  }

  /* Narrow mobile: shrink AppShell */
  @media (max-width: 480px) {
    .hero-headline {
      font-size: 30px;
      letter-spacing: -0.02em;
    }
  }
</style>
